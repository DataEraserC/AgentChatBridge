# WorkBuddy instance 1（当前顶替 LobsterAI 那个位置）
#
# 一个实例 = 一个独立 driver 进程 + 一个桥 harness id + 一个独立 state 根 +
# 一个独立 MCP 回调端口。不要和别的实例共用这些值。
#
# GUI 侧启动方式（不要直接启动 app）：
#   multi-instance workbuddy 1
# 它是 /run/current-system/sw/bin/multi-instance，签名
#   multi-instance <app> <instance> [args...]   # 两个位置参数都必填
# 用 bwrap 把实例状态目录 bind-mount 到 $HOME 下固定路径；真实 ~/.codebuddy、
# ~/.config/LobsterAI 不会被写入。实例 1 的 GUI 状态目录是
#   ~/.local/state/multi-instance/workbuddy/1
# 首次启动是空 profile，必须在实例窗口里重新登录 WorkBuddy。
#
# 注意：下面的 ACB_WB_STATE_DIR 是 *driver* 自己的 state 根，和上面 GUI 实例目录
# 是两套。不推荐把它指到 GUI 实例目录共用登录态（同一个 .codebuddy 双写有
# 锁/DB 竞争风险）；确需复用登录态时按文档的受控步骤：先在实例里登录，再单实例
# 独占试一次。

ACB_ENDPOINT=127.0.0.1:7700
ACB_TOKEN=换成和-bridge-config-一致的接入令牌

# 桥侧 [[harnesses]] id 和 [[sessions]] harness 都要写成这个值。
ACB_HARNESS=workbuddy-1
ACB_WB_INSTANCE=workbuddy-1

# 实例 state 根：同时作为子进程 HOME、CODEBUDDY_CONFIG_DIR、CODEBUDDY_DATA_ROOT
# 的根。登录态和 -r 会话记录都落在这里，不会和 workbuddy-2 共享。
# 不给时默认是 <XDG_STATE_HOME 或 ~/.local/state>/acb/workbuddy/workbuddy-1。
ACB_WB_STATE_DIR=/home/you/.local/state/acb/workbuddy/workbuddy-1

# 独立 MCP 回调端口；instance 2 用 7719。0 = 系统分配（也可以，但排障时端口会变）。
ACB_MCP_PORT=7718
# 传给 CLI 的回调 URL 由适配器每轮生成：http://127.0.0.1:7718/mcp
# 参考形状见 mcp-config.example.json。

# 只预批准这些桥工具（裸名即可；适配器会自动补 mcp__acb__ 前缀）。
ACB_WB_ALLOWED_TOOLS=send_message,send_message_to,list_rooms,capabilities,platform_call,access_request,access_ticket_get,ack_messages,get_history,fetch_records,notes,memory_read,memory_write,memory_list,memory_search,memory_git,tasks,report_feedback,feedback,feedback_reply,wait_message

# headless bundle；不填时从 workbuddy 安装布局推导。
# ACB_WB_CLI=/nix/store/<hash>-workbuddy-<ver>/opt/WorkBuddy/resources/app.asar.unpacked/cli/dist/codebuddy-headless.js

ACB_WB_SETTINGS='{"enableAllProjectMcpServers":true}'
