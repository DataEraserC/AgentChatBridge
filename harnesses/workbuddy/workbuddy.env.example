# WorkBuddy 适配器的环境变量总览。
#
# 多实例请看 instance-1.env.example / instance-2.env.example：
# 每个实例一个独立 driver 进程、独立 harness id、独立 state 根、独立 MCP 端口、
# 独立会话 id 前缀（acb-<instance>-<acb-session>）。
#
# GUI 侧也走 multi-instance wrapper，不要直接启动 app：
#   multi-instance workbuddy 1
#   multi-instance workbuddy 2
# GUI 实例状态在 ~/.local/state/multi-instance/workbuddy/<instance>，首次为空
# profile，要在实例里重新登录；driver 的 ACB_WB_STATE_DIR 是另一套目录，默认
# ~/.local/state/acb/workbuddy/<instance>。
#
# 只用 headless bundle：cli/dist/codebuddy-headless.js。
# 上游 WorkBuddy 发行物没有 dist/codebuddy.js，不要依赖 bin/codebuddy 的 full TUI 入口。

ACB_ENDPOINT=127.0.0.1:7700
ACB_TOKEN=换成和-bridge-config-一致的接入令牌

# 桥侧 harness id；也是默认的实例名。多实例时必须和 ACB_WB_INSTANCE 一致。
ACB_HARNESS=workbuddy-1
ACB_WB_INSTANCE=workbuddy-1

# 实例 state 根：HOME / CODEBUDDY_CONFIG_DIR / CODEBUDDY_DATA_ROOT 都指向它。
# 不填时默认是 <XDG_STATE_HOME 或 ~/.local/state>/acb/workbuddy/<instance>。
# ACB_WB_STATE_DIR=/home/you/.local/state/acb/workbuddy/workbuddy-1

# MCP 每轮由适配器自己起；0 = 系统分配。多实例建议显式给不同端口（7718 / 7719）。
ACB_MCP_PORT=7718

# 显式指到 headless bundle；不填时会从 workbuddy 的安装布局推导。
# 常见路径：
#   /nix/store/<hash>-workbuddy-<ver>/opt/WorkBuddy/resources/app.asar.unpacked/cli/dist/codebuddy-headless.js
# ACB_WB_CLI=/path/to/codebuddy-headless.js

# 如果你确实只能拿到 bin/codebuddy launcher，必须显式强制无头 bundle；
# 不设这个变量时适配器会拒绝 launcher。
# CODEBUDDY_FORCE_HEADLESS_BUNDLE=1

# CLI 设置。默认预批准项目 MCP。
ACB_WB_SETTINGS='{"enableAllProjectMcpServers":true}'

# 默认不指定权限模式；--allowedTools 已经预批准桥工具。
# ACB_WB_PERMISSION_MODE=acceptEdits

# 只预批准这些桥工具（裸名即可；适配器会自动补 mcp__acb__ 前缀）。
# 不填 = 全部桥工具。
# ACB_WB_ALLOWED_TOOLS=send_message,ack_messages,list_rooms,capabilities,platform_call

# 可选：透传 --tools。实测 CLI 2.147.0 下 --tools "" 并没有移除内置工具
# （Bash/Edit/Read…仍然出现），所以适配器默认不传；需要限制时按 CLI 文档试。
# ACB_WB_TOOLS=default

# CLI 工作目录；默认适配器进程的当前目录。
# ACB_WB_CWD=/path/to/workspace
