# WorkBuddy 适配器的环境变量示例。
#
# 只用 headless bundle：cli/dist/codebuddy-headless.js。
# 上游 WorkBuddy 发行物没有 dist/codebuddy.js，不要依赖 bin/codebuddy 的 full TUI 入口。

ACB_ENDPOINT=127.0.0.1:7700
ACB_TOKEN=换成和-bridge-config-一致的接入令牌
ACB_HARNESS=workbuddy

# MCP 每轮由适配器自己起；0 = 系统分配，URL 会通过 --mcp-config 传给 CLI。
ACB_MCP_PORT=0

# 显式指到 headless bundle；不填时会从 workbuddy 的安装布局推导。
# 常见路径：
#   /nix/store/<hash>-workbuddy-<ver>/opt/WorkBuddy/resources/app.asar.unpacked/cli/dist/codebuddy-headless.js
# ACB_WB_CLI=/path/to/codebuddy-headless.js

# 如果你确实只能拿到 bin/codebuddy launcher，必须显式强制无头 bundle；
# 不设这个变量时适配器会拒绝 launcher。
# CODEBUDDY_FORCE_HEADLESS_BUNDLE=1

# CLI 设置。默认预批准项目 MCP。
ACB_WB_SETTINGS='{"enableAllProjectMcpServers":true}'

# 默认不指定权限模式；--allowedTools 已经预批准桥工具。
# ACB_WB_PERMISSION_MODE=acceptEdits

# 可选：透传 --tools。实测 CLI 2.147.0 下 --tools "" 并没有移除内置工具
# （Bash/Edit/Read…仍然出现），所以适配器默认不传；需要限制时按 CLI 文档试。
# ACB_WB_TOOLS=default

# CLI 工作目录；默认适配器进程的当前目录。
# ACB_WB_CWD=/path/to/workspace
