# LobsterAI 适配器的环境变量示例。
#
# 重要：ACB_LA_STATE_DIR 必须是 LobsterAI 自己的 state 目录
# （<userData>/openclaw/state），不能指向 ~/.openclaw。裸 OpenClaw 不走
# LobsterAI 额度 / token proxy，适配器会直接拒绝启动。

ACB_ENDPOINT=127.0.0.1:7700
ACB_TOKEN=换成和-bridge-config-一致的接入令牌
ACB_HARNESS=lobsterai

# MCP 端口要和 openclaw.user.json 里的 URL 一致；生产上给固定值。
ACB_MCP_PORT=7717

# Linux 默认：~/.config/LobsterAI/openclaw/state
# macOS 默认：~/Library/Application Support/LobsterAI/openclaw/state
# 不给 ACB_LA_STATE_DIR 时按平台默认推导；目录不存在会直接报错。
# ACB_LA_STATE_DIR=/home/you/.config/LobsterAI/openclaw/state

# 不填就从 state 目录读 gateway-port.json + gateway-token。
# 两样都没有时适配器报错，不会猜默认端口。
# ACB_LA_GATEWAY_URL=ws://127.0.0.1:18789
# ACB_LA_GATEWAY_TOKEN=...

# 可选：给 ACB 用一个专用 agent，session key 会写成 agent:<id>:acb-...
# 这样 LobsterAI 自带的 QQ/微信/飞书通道不会被同一条消息重复回复。
# ACB_LA_AGENT=acb
