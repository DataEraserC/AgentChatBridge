# LobsterAI 适配器的环境变量示例。
#
# GUI 侧启动方式（不要直接启动 app）：
#   multi-instance lobsterai 1
# 它是 /run/current-system/sw/bin/multi-instance，签名
#   multi-instance <app> <instance> [args...]   # 两个位置参数都必填
# 用 bwrap 把实例状态挂到 $HOME 下固定路径；真实 ~/.config/LobsterAI 不会被写入。
# 首次启动是空 profile，必须在实例窗口里登录 LobsterAI，并等它生成
# openclaw/state（含 openclaw.json、gateway-port.json、gateway-token）。
# app 没运行 / 没登录时，适配器没有 gateway 可连，会直接报错。
#
# 重要：ACB_LA_STATE_DIR 必须是 LobsterAI 自己的 state 目录
# （<userData>/openclaw/state，Linux 即 ~/.config/LobsterAI/openclaw/state），
# 不能指向 ~/.openclaw。裸 OpenClaw 不走 LobsterAI 额度 / token proxy，
# 适配器会直接拒绝启动。如果 multi-instance 把状态挂到别的实例根，就指到
# 该实例里等价的 openclaw/state 路径。
#
# 当前状态：LobsterAI 待 app 登录后启用；桥上的槽位暂时由 workbuddy-1 顶替。

ACB_ENDPOINT=127.0.0.1:7700
ACB_TOKEN=换成和-bridge-config-一致的接入令牌
ACB_HARNESS=lobsterai

# MCP 端口固定 7717，必须和 openclaw.user.json 里的 URL 一致。
ACB_MCP_PORT=7717

# Linux：~/.config/LobsterAI/openclaw/state
# macOS：~/Library/Application Support/LobsterAI/openclaw/state
# 显式写死，避免误落到裸 OpenClaw 的 ~/.openclaw。
ACB_LA_STATE_DIR=/home/you/.config/LobsterAI/openclaw/state

# 不填就从 state 目录读 gateway-port.json + gateway-token。
# 两样都没有时适配器报错，不会猜默认端口。
# ACB_LA_GATEWAY_URL=ws://127.0.0.1:18789
# ACB_LA_GATEWAY_TOKEN=...

# 可选：给 ACB 用一个专用 agent，session key 会写成 agent:<id>:acb-...
# 这样 LobsterAI 自带的 QQ/微信/飞书通道不会被同一条消息重复回复。
# ACB_LA_AGENT=acb
