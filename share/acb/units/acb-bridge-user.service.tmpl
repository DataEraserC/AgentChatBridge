# acb-managed: generated by acb unit; do not edit
[Unit]
Description=ACB launcher (static acbl, user scope)
After=network.target
# 退出码契约固定在模板里：75 = 提交后请求重拉，78 = 放弃自动恢复。
StartLimitIntervalSec=60
StartLimitBurst=3
StartLimitAction=none

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=@ACB_UNIT_WORK_DIR@
Environment=PATH=@ACB_UNIT_BIN_DIR@:/run/current-system/sw/bin:/run/wrappers/bin
Environment=ACB_ENDPOINT_LISTEN=@ACB_UNIT_ENDPOINT_LISTEN@
Environment=ACB_CONSOLE_LISTEN=@ACB_UNIT_CONSOLE_LISTEN@
Environment=ACB_RELAY_LISTEN=@ACB_UNIT_RELAY_LISTEN@
Environment=ACB_LUA_DIR=@ACB_UNIT_PROFILE_DIR@/current/examples/lua
Environment=ACB_PROFILE_DIR=@ACB_UNIT_PROFILE_DIR@
Environment=ACB_STATE_DIR=@ACB_UNIT_STATE_DIR@
# launcher 拉起 bridge 时用它定位 bridge 配置。
Environment=ACB_UNIT_CONFIG_FILE=@ACB_UNIT_CONFIG_FILE@
EnvironmentFile=-@ACB_UNIT_ENV_FILE@
ExecStart=@ACB_UNIT_LAUNCHER_BIN@
# acbl 只是 bridge 的观察者/恢复者，不是所有者：停 acbl 时不连带杀 bridge。
KillMode=process
Restart=on-failure
RestartForceExitStatus=75
RestartPreventExitStatus=78
RestartSec=1
TimeoutStopSec=45
WatchdogSec=120
StandardOutput=append:@ACB_UNIT_LOG_DIR@/bridge.log
StandardError=append:@ACB_UNIT_LOG_DIR@/bridge.log

[Install]
WantedBy=default.target
