# acb-managed: generated by acb unit; do not edit
[Unit]
Description=ACB launcher (static acbl, system scope)
After=network.target
PartOf=acb-stack.target
# 退出码契约固定在模板里：75 = 提交后请求重拉，78 = 放弃自动恢复。
StartLimitIntervalSec=60
StartLimitBurst=3
StartLimitAction=none

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=@ACB_UNIT_REPO_DIR@
Environment=PATH=@ACB_UNIT_BIN_DIR@
Environment=ACB_PROFILE_DIR=@ACB_UNIT_PROFILE_DIR@
Environment=ACB_STATE_DIR=@ACB_UNIT_STATE_DIR@
EnvironmentFile=-@ACB_UNIT_ENV_FILE@
ExecStart=@ACB_UNIT_LAUNCHER_BIN@ --config @ACB_UNIT_SUPERVISOR_CONFIG_FILE@
# acbl 只是 bridge 的观察者/恢复者，不是所有者：停 acbl 时不连带杀 bridge。
KillMode=process
Restart=on-failure
RestartForceExitStatus=75
RestartPreventExitStatus=78
RestartSec=1
TimeoutStopSec=45
WatchdogSec=120
StandardOutput=append:@ACB_UNIT_LOG_DIR@/launcher.log
StandardError=append:@ACB_UNIT_LOG_DIR@/launcher.log
@SYSTEM_INSTALL_SECTION@
