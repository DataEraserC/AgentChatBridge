# acb-managed: generated by acb unit; do not edit
[Unit]
Description=ACB bridge
After=network.target
PartOf=acb-stack.target
# 退出码契约固定在模板里：75 = 请求重启，78 = 配置错误不重启。
StartLimitIntervalSec=60
StartLimitBurst=3
StartLimitAction=none

[Service]
Type=simple
WorkingDirectory=@ACB_UNIT_REPO_DIR@
Environment=PATH=@ACB_UNIT_PROFILE_DIR@/bin:/run/current-system/sw/bin:/run/wrappers/bin
EnvironmentFile=-@ACB_UNIT_ENV_FILE@
ExecStart=@ACB_UNIT_BIN_DIR@/acb-bridge --config @ACB_UNIT_CONFIG_FILE@
Restart=on-failure
RestartForceExitStatus=75
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=45
# Watchdog 固定关闭：Type=simple，进程不发送 sd_notify。
WatchdogSec=0
KillMode=control-group
StandardOutput=append:@ACB_UNIT_LOG_DIR@/bridge.log
StandardError=append:@ACB_UNIT_LOG_DIR@/bridge.log
