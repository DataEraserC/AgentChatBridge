# acb-managed: generated by acb unit; do not edit
[Unit]
Description=ACB dsh harness
After=network.target
PartOf=acb-stack.target
# 重启策略与限流固定在模板里，ACB_UNIT_* 只能改路径/端口/profile/env 文件。
StartLimitIntervalSec=60
StartLimitBurst=3
StartLimitAction=none

[Service]
Type=simple
WorkingDirectory=@ACB_UNIT_REPO_DIR@
Environment=PATH=@ACB_UNIT_PROFILE_DIR@/bin:/run/current-system/sw/bin:/run/wrappers/bin
EnvironmentFile=-@ACB_UNIT_ENV_FILE@
ExecStart=/run/current-system/sw/bin/bash @ACB_UNIT_REPO_DIR@/deploy/start-dsh.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
# Watchdog 固定关闭：Type=simple，进程不发送 sd_notify。
WatchdogSec=0
StandardOutput=append:@ACB_UNIT_LOG_DIR@/dsh.log
StandardError=append:@ACB_UNIT_LOG_DIR@/dsh.log
