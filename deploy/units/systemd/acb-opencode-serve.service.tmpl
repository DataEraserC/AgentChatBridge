# acb-managed: generated by acb unit; do not edit
[Unit]
Description=ACB opencode v2 server (serve)
After=network.target
PartOf=acb-stack.target
StartLimitIntervalSec=60
StartLimitBurst=3
StartLimitAction=none

[Service]
Type=simple
WorkingDirectory=@ACB_UNIT_OPENCODE_DIR@
Environment=PATH=@ACB_UNIT_PROFILE_DIR@/bin:/run/current-system/sw/bin:/run/wrappers/bin
Environment=ACB_OPENCODE_DIR=@ACB_UNIT_OPENCODE_DIR@
Environment=ACB_OPENCODE_PORT=@ACB_UNIT_OPENCODE_PORT@
ExecStart=@ACB_UNIT_SHELL@ @ACB_UNIT_REPO_DIR@/deploy/opencode-serve.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
# Watchdog 固定关闭：Type=simple，进程不发送 sd_notify。
WatchdogSec=0
StandardOutput=append:@ACB_UNIT_LOG_DIR@/opencode-serve.log
StandardError=append:@ACB_UNIT_LOG_DIR@/opencode-serve.log
