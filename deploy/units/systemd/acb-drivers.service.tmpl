# acb-managed: generated by acb unit; do not edit
[Unit]
Description=ACB dsh drivers
After=acb-bridge.service
Wants=acb-bridge.service
PartOf=acb-stack.target
StartLimitIntervalSec=60
StartLimitBurst=3
StartLimitAction=none

[Service]
Type=simple
WorkingDirectory=@ACB_UNIT_REPO_DIR@/deploy
Environment=PATH=@ACB_UNIT_PROFILE_DIR@/bin:/run/current-system/sw/bin:/run/wrappers/bin
ExecStart=/run/current-system/sw/bin/bash @ACB_UNIT_REPO_DIR@/deploy/start-drivers.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
# Watchdog 固定关闭：Type=simple，进程不发送 sd_notify。
WatchdogSec=0
StandardOutput=append:@ACB_UNIT_LOG_DIR@/drivers.log
StandardError=append:@ACB_UNIT_LOG_DIR@/drivers.log
