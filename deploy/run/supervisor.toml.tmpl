# acb-managed: acb maintains [supervisor]; [[component]] declarations are preserved.
[supervisor]
program = "@SUPERVISOR_PROGRAM@"
args = @SUPERVISOR_ARGS@
@HEALTH_URL_LINE@
@HEALTH_TOKEN_SECTION@state_dir = "@RUN_STATE_DIR@"
probe_interval_secs = 5
stable_window_secs = 60
lkg_update = "on_stable"
rollback = "lkg"
rollback_mode = "external"
@GENERATION_SECTION@
[supervisor.policy]
provider = "acb.supervisor.default"
decision_timeout_ms = 1000
policy_error_fail_after = 3
on_policy_error = "hold"
startup_grace_secs = 30
consecutive_failures = 3
window_failures = 5
window_secs = 600
panic_classes = ["panic"]
panic_rollback = true
provider_parse_uses_window = true
unhealthy_secs = 60
unhealthy_probes = 3
restart_backoff_secs = [1, 2, 4, 8, 30]
