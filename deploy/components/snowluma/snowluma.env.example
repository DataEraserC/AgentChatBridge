# SnowLuma 容器 env 模板 —— 复制成 deploy/snowluma.env 后填真值。
#
#   cp deploy/snowluma.env.example deploy/snowluma.env
#   chmod 600 deploy/snowluma.env      # 含远程桌面密码，必须收紧权限
#
# 真值文件 deploy/snowluma.env 已被 .gitignore 忽略，永不入库。
# 本模板只放占位符与非敏感默认值。
#
# 谁读它：deploy/snowluma.sh 用 --env-file 指向真值文件。
# 为什么必须显式指定：compose 在 deploy/，podman-compose 默认只读 compose
# 同目录的 .env；不指定就会读不到下面的端口值，静默退回 3000/3001/6081/5099，
# 而 ACB 按 53000/53001 访问 —— 桥连不上且没有任何报错提示端口错了。
#
# ⚠️ 下面四个宿主端口是现网值，ACB 依赖它们（config.active.toml 抬头写明
#    「53001 = WS，53000 = HTTP」）。改了会切断 ACB，不要动。

# ── 宿主端口（现网值，勿改）──────────────────────────────────────────────
# noVNC 远程桌面：扫码登录入口，所有 QQ 窗口都在这一个桌面里
NOVNC_PORT=56081
# SnowLuma WebUI：账号列表 / 进程注入 / 每账号 OneBot 配置
SNOWLUMA_WEBUI_HOST_PORT=55099
# OneBot HTTP —— ACB 依赖
ONEBOT_HTTP_PORT=53000
# OneBot WebSocket —— ACB 依赖
ONEBOT_WS_PORT=53001

# ── 远程桌面密码（敏感，必填真值）────────────────────────────────────────
# 留空则镜像首次启动随机生成并打印一次到日志：
#   podman logs snowluma 2>&1 | grep -E "远程桌面密码:|remote desktop password:"
# 设了固定值就用它。noVNC 等于一台能操作你 QQ 的远程桌面，别裸放公网。
VNC_PASSWD=CHANGE_ME_OR_LEAVE_EMPTY_FOR_RANDOM

# ── 容器内运行身份与 WebUI 监听 ──────────────────────────────────────────
SNOWLUMA_UID=1000
SNOWLUMA_GID=1000
SNOWLUMA_WEBUI_HOST=0.0.0.0
# 容器内端口，一般不改（宿主映射见上面的 SNOWLUMA_WEBUI_HOST_PORT）
SNOWLUMA_WEBUI_PORT=5099

# ── 日志与屏幕 ──────────────────────────────────────────────────────────
# 多账号后事件量成倍增长，低 IOPS 云盘建议改 warn
SNOWLUMA_LOG_LEVEL=info
# 多账号建议降到 1280x720x24（像素少一半以上，抓帧/合成负载同步下降）
SNOWLUMA_SCREEN=1920x1080x24

# 扫码后自动注入 hook，无需去 WebUI 逐个点 Load
SNOWLUMA_HOOK_AUTOLOAD=1

# ── 多账号开关（只对 snowluma-compose.multi.yml 有意义）──────────────────
# 留空 = 单账号运行。每个路径对应一个独立 QQ 进程，必须在 /app/ 下、
# 字符集限 A-Za-z0-9_@%+=:,./-，且各自有独占卷（compose 里已备好 acct2/acct3）。
#   一个额外号：SNOWLUMA_EXTRA_QQ_HOMES=/app/qq-acct2
#   两个额外号：SNOWLUMA_EXTRA_QQ_HOMES=/app/qq-acct2,/app/qq-acct3
# 启用后必须在 WebUI 给每个新账号单独分配 OneBot 端口（3020/3021、3030/3031），
# 否则撞主账号 3000/3001，配置校验属终态失败、不会自动重试。
SNOWLUMA_EXTRA_QQ_HOMES=