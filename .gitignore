# Rust
/target/

# nix 构建产物
/result
/result-*

# Node
node_modules/

# 文档站构建产物与缓存
docs/.vitepress/cache/
docs/.vitepress/dist/

# 运行时状态与本机配置（永不入库）
/state/
config.toml
/config.deprecated/
.workbuddy/
*.log
*.bak
*.bak-*
# 状态库（含 WAL 的伴生文件）
*.db
*.db-wal
*.db-shm

# 记忆仓库路径写成 "~/xxx" 时 `~` 不会展开，会落在工作目录下这个字面目录里
/~

# 部署层密钥（deploy/acb.env.example 是模板，真值不入库）
/deploy/acb.env

# SnowLuma 容器真值 env（含 VNC_PASSWD = 能操作 QQ 的远程桌面密码）。
# 模板是 deploy/snowluma.env.example，真值永不入库。
/deploy/snowluma.env
# 历史：曾用 deploy/.env（软链接 → snowluma.env）让 podman-compose 自己找到真值。
# 2026-11-19 废弃：管理内核现在显式传 `--env-file`（读组件的 process.env_file），
# 隐式兼容在换目录/换文件名时会静默失效。条目保留是为了挡住误建的软链接。
# snowluma.env 的软链接，让 supervisor 自启（只拼 -f，不带 --env-file）也能读到真值。
/deploy/.env

# 编辑器与本地环境
.direnv/
.envrc
.idea/
.vscode/
.box-agent/
